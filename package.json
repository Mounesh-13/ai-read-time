{
  "name": "ai-read-time-indicator",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-first browser extension that estimates AI response reading time locally.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build -b chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "prepare:wxt": "wxt prepare",
    "typecheck": "wxt prepare && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "eslint src tests wxt.config.ts vitest.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "@vitest/coverage-v8": "^3.0.5",
    "vitest": "^3.0.5",
    "wxt": "^0.20.6"
  }
}
